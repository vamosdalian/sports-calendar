SPORTS_CALENDAR_API_BASE_URL=http://localhost:8080
SPORTS_CALENDAR_PUBLIC_API_BASE_URL=http://localhost:8080

# Umami analytics (self-hosted, cookie-free — no consent banner required).
# Leave both empty to disable: the script is then not rendered at all.
#
# IMPORTANT: NEXT_PUBLIC_* values are inlined by Next.js at BUILD time, not
# read at runtime. Setting them as Cloudflare Worker environment variables has
# no effect — they must be present in the environment that runs
# `npm run deploy`, or the site ships with analytics silently disabled.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
