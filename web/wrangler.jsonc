{
  // Assets-only Worker: note the absence of `main`. There is no script to
  // boot, so a page request is a static file read and never counts against
  // Cloudflare's per-request CPU limit.
  //
  // The R2 bucket, Durable Object queue and service binding that used to live
  // here existed only to cache Next's ISR output. Nothing renders at request
  // time any more, so their bindings are gone.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sports-calendar-web",
  "compatibility_date": "2026-04-11",
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    },
    {
      // Retires the ISR queue created by v1. Required rather than simply
      // dropping the binding: Cloudflare rejects a deploy that abandons a
      // Durable Object class without saying so explicitly.
      "tag": "v2",
      "deleted_classes": ["DOQueueHandler"]
    }
  ],
  "assets": {
    "directory": "out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
