# Production build variables for the public site.
#
# This file IS committed (see the .gitignore exception). Reason: NEXT_PUBLIC_*
# values are inlined by Next.js at build time, and the web Worker is built by
# Cloudflare directly from Git — so the values have to be in the repo for the
# build to see them. Setting them as Worker runtime variables does nothing.
#
# Both values below are public by nature: they are served inside every page's
# HTML. Never put a secret in this file.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.sports-calendar.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=f0fc3566-43a5-448e-971f-747673fb8e9e
